# Copy this file to .env.local and fill in values for a hosted deployment.
# Local development needs NONE of these: Patchbay falls back to an embedded
# Postgres (PGlite) and the sealed offline catalog sample.

# --- Storage ---------------------------------------------------------------
# Hosted Postgres connection string. Required in production; the app refuses to
# serve production traffic from the embedded adapter on a serverless host.
# Neon: postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: isolate the schema when sharing one database instance.
# DATABASE_SCHEMA=patchbay

# --- Secrets ---------------------------------------------------------------
# Session signing secret for the anonymous scope cookie and Better Auth.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional: dedicated key-encryption secret for stored provider credentials.
# Defaults to AUTH_SECRET. Rotating either value makes stored keys unreadable.
CREDENTIAL_ENCRYPTION_KEY=

# --- Public origin ---------------------------------------------------------
# Absolute origin of this deployment. Used for metadata, canonical URLs, and
# Better Auth's trusted origins.
NEXT_PUBLIC_SITE_URL=https://patchbay.vercel.app

# Optional: extra trusted origins, comma separated (preview deployments).
# TRUSTED_ORIGINS=https://patchbay-git-main-aniruddhaadak80.vercel.app

# --- Local only ------------------------------------------------------------
# Path for the embedded Postgres data directory. Relative paths resolve against
# the project root. Defaults to .patchbay/pglite
# PGLITE_DATA_DIR=.patchbay/pglite

# Required to run `next start` with NODE_ENV=production against the embedded
# database. Refuses to run on a serverless host unless PGLITE_DATA_DIR is set.
# ALLOW_EMBEDDED_DB=true
